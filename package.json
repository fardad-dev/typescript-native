{
  "name": "tsn-compiler",
  "version": "0.1.2",
  "description": "AOT compiler: a TypeScript subset -> LLVM IR -> native executable",
  "license": "MIT",
  "author": "Fardad Mohammadi",
  "keywords": [
    "typescript",
    "compiler",
    "llvm",
    "aot",
    "native",
    "codegen"
  ],
  "homepage": "https://github.com/fardad-dev/typescript-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fardad-dev/typescript-native.git"
  },
  "bugs": {
    "url": "https://github.com/fardad-dev/typescript-native/issues"
  },
  "bin": {
    "tsn-compiler": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "tsn-compiler": "node dist/index.js",
    "bench": "node benchmark/run.mjs",
    "bench:words": "node benchmark/sort-words.mjs",
    "bench:leaderboard": "node benchmark/leaderboard.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "3.8.4",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
